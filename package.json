{
	"name": "valleyed",
	"version": "4.5.24",
	"description": "A lightweight package with definitions for various validation rules, and helper services to consume said rules.",
	"type": "module",
	"sideEffects": false,
	"packageManager": "pnpm@11.7.0",
	"engines": {
		"node": ">=20.19"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.5.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.7.0",
			"onFail": "warn"
		}
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/types/index.d.cts",
				"min": "./dist/cjs/index.min.cjs",
				"default": "./dist/cjs/index.cjs"
			},
			"import": {
				"types": "./dist/types/index.d.ts",
				"min": "./dist/esm/index.min.mjs",
				"default": "./dist/esm/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch --concurrency 1",
		"build": "tsdown --concurrency 1",
		"lint": "eslint src tests",
		"lint:fix": "eslint --fix src tests",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prerelease": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"release": "commit-and-tag-version",
		"prepare": "husky"
	},
	"keywords": [
		"typescript",
		"schema",
		"validation",
		"type",
		"inference"
	],
	"author": "Kevin Izuchukwu",
	"license": "ISC",
	"devDependencies": {
		"@commitlint/cli": "^20.4.2",
		"@commitlint/config-conventional": "^20.4.2",
		"@types/node": "^24.0.0",
		"@types/url-regex-safe": "^1.0.2",
		"commit-and-tag-version": "^13.3.0",
		"eslint": "10.14.0",
		"husky": "^9.1.7",
		"prettier": "3.10.1",
		"tsdown": "0.23.7",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"xi-configs": "0.1.0"
	},
	"files": [
		"LICENSE",
		"CHANGELOG.md",
		"README.md",
		"bin",
		"dist"
	],
	"repository": {
		"url": "git+https://github.com/andthexi/valleyed.git"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0",
		"url-regex-safe": "^4.0.0"
	},
	"commit-and-tag-version": {}
}
